{
  "name": "cmdf",
  "version": "1.0.0",
  "description": "AI-Powered Natural Language Terminal Assistant — Your intent. One command.",
  "keywords": [
    "cli",
    "terminal",
    "ai",
    "gemini",
    "assistant",
    "natural-language",
    "developer-tools",
    "cross-platform"
  ],
  "homepage": "https://github.com/prashantxdev/cmdf#readme",
  "bugs": {
    "url": "https://github.com/prashantxdev/cmdf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prashantxdev/cmdf.git"
  },
  "license": "MIT",
  "author": "cmdf Contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cmdf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
